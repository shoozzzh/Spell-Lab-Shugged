<Entity name="%MODULE_FULL_ID%.lazy_loader" >
  	<LuaComponent
		execute_every_n_frame="1"
		script_source_file="%THIS_PATH%/load.lua">
	</LuaComponent>
  	<LuaComponent
		execute_on_added="1"
		remove_after_executed="1"
		script_source_file="%THIS_PATH%/dup_check.lua">
	</LuaComponent>
    <!-- guarantee being saved by unloading the chunk after 60 frames -->
    <Entity>
        <StreamingKeepAliveComponent/>
        <LifetimeComponent lifetime="60"/>
    </Entity>
</Entity>
